{
  "info": {
    "name": "Stock-Alert v5.0 (RabbitMQ + notifications email)",
    "description": "Tests du jalon V5 : notification par email après émission/livraison d'une commande d'achat (RabbitMQ + Mailpit). Prérequis : docker compose up -d, Eureka, Config Server, service-inventaire, service-alertes, service-approvisionnement, service-notification. Ordre : V5-0, V5-1, V5-2 (Collection Runner, données initiales fraîches). Puis V5-3a service-notification ARRÊTÉ, puis redémarrer le service et lancer V5-3b.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "approvisionnement",
      "value": "http://localhost:8082"
    },
    {
      "key": "notification",
      "value": "http://localhost:8084"
    },
    {
      "key": "mailpit",
      "value": "http://localhost:8025"
    },
    {
      "key": "rabbit",
      "value": "http://localhost:15672"
    },
    {
      "key": "rabbitUser",
      "value": "stockalert"
    },
    {
      "key": "rabbitPass",
      "value": "stockalert"
    }
  ],
  "item": [
    {
      "name": "V5-0 Préparation et santé",
      "item": [
        {
          "name": "Santé de service-notification -> 200 UP",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Statut UP\", function () { pm.expect(pm.response.json().status).to.eql(\"UP\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{notification}}/actuator/health"
          }
        },
        {
          "name": "Vider Mailpit -> 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{mailpit}}/api/v1/messages"
          }
        },
        {
          "name": "File RabbitMQ durable avec dead-letter exchange -> 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"File durable\", function () { pm.expect(pm.response.json().durable).to.eql(true); });",
                  "pm.test(\"DLX configuré\", function () { pm.expect(pm.response.json().arguments[\"x-dead-letter-exchange\"]).to.eql(\"stockalert.events.dlx\"); });",
                  "pm.test(\"Un consommateur est connecté\", function () { pm.expect(pm.response.json().consumers).to.be.at.least(1); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{rabbit}}/api/queues/%2F/notification.purchase-order",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{rabbitUser}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{rabbitPass}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "File des messages morts (DLQ) existe -> 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{rabbit}}/api/queues/%2F/notification.purchase-order.dlq",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{rabbitUser}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{rabbitPass}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Purger la DLQ -> 204",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code HTTP 204\", function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{rabbit}}/api/queues/%2F/notification.purchase-order.dlq/contents",
            "auth": {
              "type": "basic",
