    {
      "name": "V5-1 Parcours complet - succès",
      "item": [
        {
          "name": "1. Créer une commande (stock bas) -> 201 BROUILLON",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Statut BROUILLON\", function () { pm.expect(pm.response.json().statut).to.eql(\"BROUILLON\"); });",
                  "pm.collectionVariables.set(\"v5OrderId\", pm.response.json().id);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('cleIdem', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{cleIdem}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{approvisionnement}}/purchase-orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"supplierId\": 1,\n  \"productId\": 1,\n  \"entrepot\": \"Rabat\",\n  \"quantiteCommandee\": 30\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "2. La simple création n'envoie aucun email -> total 0",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Aucun email\", function () { pm.expect(pm.response.json().total).to.eql(0); });"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// attente du traitement asynchrone (1500 ms)",
                  "setTimeout(function () {}, 1500);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{mailpit}}/api/v1/messages"
          }
        },
        {
          "name": "3. Émettre la commande -> 200 EMISE, réponse rapide",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Statut EMISE\", function () { pm.expect(pm.response.json().statut).to.eql(\"EMISE\"); });",
                  "pm.test(\"Réponse sans attendre l'email (< 2 s)\", function () { pm.expect(pm.response.responseTime).to.be.below(2000); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{approvisionnement}}/purchase-orders/{{v5OrderId}}/emettre"
          }
        },
        {
          "name": "4. Mailpit reçoit l'email du fournisseur (après traitement asynchrone)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "var j = pm.response.json();",
                  "pm.test(\"Un seul email\", function () { pm.expect(j.total).to.eql(1); });",
                  "pm.test(\"Sujet : commande émise\", function () { pm.expect(j.messages[0].Subject).to.include(\"n°\" + pm.collectionVariables.get(\"v5OrderId\") + \" émise\"); });",
                  "pm.test(\"Destinataire = email du fournisseur\", function () { pm.expect(j.messages[0].To[0].Address).to.eql(\"commandes@techdistrib.ma\"); });",
                  "pm.test(\"Expéditeur\", function () { pm.expect(j.messages[0].From.Address).to.eql(\"stock-alert@stockalert.local\"); });"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// attente du traitement asynchrone (3000 ms)",
                  "setTimeout(function () {}, 3000);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{mailpit}}/api/v1/messages"
          }
        },
        {
          "name": "5. Contenu du dernier email (texte + HTML)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "var m = pm.response.json();",
                  "pm.test(\"Texte : quantité et entrepôt\", function () { pm.expect(m.Text).to.include(\"30\").and.to.include(\"Rabat\"); });",
                  "pm.test(\"Texte : nom du produit (enrichi via OpenFeign)\", function () { pm.expect(m.Text).to.include(\"Dell Latitude\"); });",
                  "pm.test(\"Version HTML présente\", function () { pm.expect(m.HTML).to.include(\"<table\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{mailpit}}/api/v1/message/latest"
          }
        },
        {
          "name": "6. Historique côté consommateur -> 1 notification ENVOYEE",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "var l = pm.response.json();",
                  "pm.test(\"Une notification\", function () { pm.expect(l.length).to.eql(1); });",
                  "pm.test(\"Type et statut\", function () { pm.expect(l[0].type).to.eql(\"PURCHASE_ORDER_EMISE\"); pm.expect(l[0].statut).to.eql(\"ENVOYEE\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{notification}}/notifications?purchaseOrderId={{v5OrderId}}"
          }
        },
        {
          "name": "7. Livrer la commande -> 200 LIVREE",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Statut LIVREE\", function () { pm.expect(pm.response.json().statut).to.eql(\"LIVREE\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{approvisionnement}}/purchase-orders/{{v5OrderId}}/livrer"
          }
        },
        {
          "name": "8. Second email : livraison confirmée",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "var j = pm.response.json();",
                  "pm.test(\"Deux emails au total\", function () { pm.expect(j.total).to.eql(2); });",
                  "pm.test(\"Le plus récent concerne la livraison\", function () { pm.expect(j.messages[0].Subject).to.include(\"livrée\"); });"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// attente du traitement asynchrone (3000 ms)",
                  "setTimeout(function () {}, 3000);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{mailpit}}/api/v1/messages"
          }
        },
        {
          "name": "9. File principale vidée (tout est consommé)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Aucun message en attente\", function () { pm.expect(pm.response.json().messages_ready).to.eql(0); });"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// attente du traitement asynchrone (6000 ms)",
                  "setTimeout(function () {}, 6000);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{rabbit}}/api/queues/%2F/notification.purchase-order",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{rabbitUser}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{rabbitPass}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
