                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Statut EMISE\", function () { pm.expect(pm.response.json().statut).to.eql(\"EMISE\"); });",
                  "pm.test(\"Réponse rapide (< 2 s)\", function () { pm.expect(pm.response.responseTime).to.be.below(2000); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{approvisionnement}}/purchase-orders/{{v5DelayedId}}/emettre"
          }
